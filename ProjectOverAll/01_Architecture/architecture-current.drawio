        <!-- ===== PaaS / ID ===== -->
        <mxCell id="storage" value="stacpdevjpe001（Storage Account）&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Standard LRS / TLS1.2 / 匿名アクセス禁止&lt;br&gt;コンテナ：app-data（非公開）&lt;br&gt;FW：既定拒否＋自宅 IP と app Subnet のみ許可&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
