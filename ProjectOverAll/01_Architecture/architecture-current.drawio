<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="acp-current" name="現在の構成（Phase2 完了時点）">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Azure Common Platform - 現在の構成図（Phase2 完了時点・Terraform apply 済み）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
